# Dedicated Minecraft access bot. Copy these values to .env.minecraft.
# Required secrets and identity.
MINECRAFT_DISCORD_BOT_TOKEN=
MINECRAFT_GUILD_ID=
MINECRAFT_BRIDGE_SECRET=

# Process and bridge infrastructure. The displayed defaults normally need no change.
MINECRAFT_SERVER_ID=mysterious-smp-x
MINECRAFT_BRIDGE_PATH=/minecraft-bridge
MINECRAFT_BRIDGE_HOST=0.0.0.0
MINECRAFT_BRIDGE_PORT=8080
# Optional direct WSS certificate and private-key paths. Set both or neither.
# MINECRAFT_BRIDGE_TLS_CERT=runtime/minecraft/bridge-cert.pem
# MINECRAFT_BRIDGE_TLS_KEY=runtime/minecraft/bridge-key.pem
MINECRAFT_ALLOW_INSECURE_LOCALHOST=0
MINECRAFT_DATA_DIR=runtime/minecraft

# Local-first game dashboard. Register the exact callback URL in the Discord
# application's OAuth2 settings before filling its client secret.
MINECRAFT_DASHBOARD_ENABLED=1
MINECRAFT_DASHBOARD_HOST=127.0.0.1
MINECRAFT_DASHBOARD_PORT=8090
MINECRAFT_DASHBOARD_PUBLIC_URL=http://127.0.0.1:8090
MINECRAFT_DASHBOARD_CLIENT_SECRET=

# After the bot starts, run /minecraft setup to configure channels, roles, and addresses.
